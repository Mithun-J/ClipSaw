# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/

# Node
node_modules/
dist/
.cache/

# Media processing & downloads storage (ignore contents but keep directory structure)
storage/downloads/*
!storage/downloads/.gitkeep

storage/audio/*
!storage/audio/.gitkeep

storage/clips/*
!storage/clips/.gitkeep

storage/temp/*
!storage/temp/.gitkeep

storage/models/*
!storage/models/.gitkeep

*.mp4
*.mp3
*.wav
*.mkv
*.webm
*.bin
*.part
*.ytdl

# Environment variables & secrets
.env
.env.local

# OS files
Thumbs.db
Desktop.ini
.DS_Store
